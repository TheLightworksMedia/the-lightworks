---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Lightworks | Editorial Portfolio">
  <div class="page-wrapper">
    
    <header class="site-nav-header">
      <div class="nav-brand">
        <span class="brand-title">THE LIGHTWORKS</span>
        <span class="brand-subtitle">ARCHITECTURAL & REAL ESTATE MEDIA</span>
      </div>
      <nav class="nav-links">
        <a href="#home">HOME</a>
        <a href="#about">ABOUT</a>
        <a href="#services">SERVICES</a>
        <a href="#portfolio">PORTFOLIO</a>
        <a href="#contact">CONTACT</a>
      </nav>
    </header>

    <section class="first-photo-fullwidth" id="home">
      <div class="fullwidth-image-wrapper hero-slider">
        <img 
          class="active" 
          src="/images/DSC08582-HDR-Export.jpg" 
          alt="The Woodland Spa Estate" 
        />
        <img 
          src="/images/DSC08537-HDR-Export.jpg" 
          alt="The Concrete Horizon" 
        />
        <img 
          src="/images/DSC08642-HDR-Export.jpg" 
          alt="Spatial Fluidity" 
        />
      </div>

      <div class="caption-centered">
          &nbsp;
      </div>
    </section>

    <section class="image-break vertical-layout" id="about">
      <div class="image-wrapper">
        <img src="/images/DSC08975-HDR-Export.jpg" alt="Minimalist Interior Volume" />
      </div>
      <div class="content-side">
        <h2>About</h2>
        <p class="body-text">
          We are dedicated to creating exceptional, editorial-style architectural imagery and real estate media. Working closely with our clients, we tailor every capture to align with the unique vision and character of the property.
        </p>
        <p class="body-text">
          Our approach is centered on natural light—how it enters, interacts with, and elevates spatial design. From high-resolution photography to immersive videography, we provide comprehensive media solutions tailored to your complete project needs.
        </p>
      </div>

      <div class="full-width-divider"></div>
    </section>

	<section class="video-break" id="portfolio">
      <div class="video-wrapper">
        <video autoplay muted loop playsinline preload="auto">
          <source src="/videos/architectural-reel.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
      <div class="caption-centered">
        <span class="caption-title">The Concrete Horizon</span>
        <span class="caption-category">Cinematic Study</span>
      </div>
    </section>

    <section class="image-break double-spread">
      <div class="image-wrapper">
        <img src="/images/DSC08785-HDR-Export.jpg" alt="Architectural Detail Shot Left" />
      </div>
      <div class="image-wrapper">
        <img src="/images/DSC08930-HDR-Export.jpg" alt="Architectural Detail Shot Right" />
      </div>
    </section>
    
    <div class="caption-centered double-caption">
      <span class="caption-title">Material & Spatial Studies</span>
      <span class="caption-category">Detail Curation</span>
    </div>

    <section class="image-break landscape">
      <div class="image-wrapper">
        <img src="/images/DSC08642-HDR-Export.jpg" alt="Open Living Space Geometry" />
      </div>
      <div class="caption-centered">
        <span class="caption-title">Spatial Fluidity</span>
        <span class="caption-category">Interior Horizon</span>
      </div>
    </section>

	<section class="services-section" id="services">
      <div class="text-container centered">
        <h2>Curated Services</h2>
        <p class="subtitle italic">Meticulous documentation for the built environment</p>
      </div>

      <div class="services-grid-2x3">
        <div class="service-tile">
          <img src="/images/DSC08582-HDR-Export.jpg" alt="Architectural Photography" />
          <div class="tile-overlay">
            <h3>Photography</h3>
            <p class="tile-description">Meticulously composed stills emphasizing texture, spatial flow, and natural daylight.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08537-HDR-Export.jpg" alt="Architectural Videography" />
          <div class="tile-overlay">
            <h3>Videography</h3>
            <p class="tile-description">Cinematic walkthroughs highlighting the true atmosphere and flow of luxury spaces.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08642-HDR-Export.jpg" alt="Drone Media" />
          <div class="tile-overlay">
            <h3>Drone</h3>
            <p class="tile-description">Elevated aerial views showcasing the property layout and surrounding landscape context.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08785-HDR-Export.jpg" alt="Floorplans" />
          <div class="tile-overlay">
            <h3>Floorplans</h3>
            <p class="tile-description">Precise, professional 2D and 3D schematics mapping accurate spatial dimensions.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08930-HDR-Export.jpg" alt="360 Tours" />
          <div class="tile-overlay">
            <h3>360 Tours</h3>
            <p class="tile-description">Interactive digital environments allowing seamless remote exploration of the property.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08975-HDR-Export.jpg" alt="Social Media Content" />
          <div class="tile-overlay">
            <h3>Social Media</h3>
            <p class="tile-description">Engaging, short-form visual content optimized for digital marketing and high-end reach.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="portfolio-continuation">
      <section class="image-break vertical-layout reverse">
        <div class="image-wrapper">
          <img src="/images/DSC08587-HDR-Export.jpg" alt="Urban Luxury Living Vertical" />
        </div>
        <div class="content-side">
          <h2>Penthouse Proportion</h2>
          <p class="body-text">
            Balancing natural daylight with structural integrity, this composition emphasizes height, luxury texture, and spatial clarity for high-end portfolio curation.
          </p>
          <span class="category-tag">Luxury Editorial</span>
        </div>
      </section>

      <section class="image-break landscape">
        <div class="image-wrapper">
          <img src="/images/DSC08763-HDR-Export.jpg" alt="Bright Spatial Photography" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Diffused Light</span>
          <span class="caption-category">Luminous Interiors</span>
        </div>
      </section>

      <section class="image-break landscape space-top">
        <div class="image-wrapper">
          <img src="/images/DSC08868-HDR-Export.jpg" alt="Interior Geometry and Texture" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Textural Harmony</span>
          <span class="caption-category">Residential Curation</span>
        </div>
      </section>

      <section class="image-break landscape space-top">
        <div class="image-wrapper">
          <img src="/images/DSC08990-HDR-Export.jpg" alt="Twilight Architecture Exterior" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Evening Atmosphere</span>
          <span class="caption-category">Twilight Ambiance</span>
        </div>
      </section>
    </div>

    <footer class="footer-section" id="contact">
      <div class="text-container centered">
        <h2>Enquiries</h2>
        <p class="subtitle italic">For commissioning and collaborative rates</p>
        
        <div class="contact-details">
          <a href="mailto:info@thelightworks.art" class="contact-email">info@thelightworks.art</a>
          <p class="contact-phone">+44 (0) 20 7946 0912</p>
        </div>

        <form class="luxury-form" onsubmit="event.preventDefault();">
          <div class="form-group">
            <input type="text" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <input type="email" placeholder="Your Email Address" required />
          </div>
          <div class="form-group">
            <textarea placeholder="Project Details & Location" rows="4" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Inquiry</button>
        </form>
        
        <p class="copyright">&copy; 2026 The Lightworks. All Rights Reserved.</p>
      </div>
    </footer>

  </div>
</Layout>

<style>
  :root {
    --bg-cream: #F9F6F0;
    --text-mahogany: #241A16;
    --muted-mahogany: #63524A;
    --border-mahogany: rgba(36, 26, 22, 0.15);
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-cream) !important;
  }

  body {
    background-color: var(--bg-cream) !important;
    color: var(--text-mahogany) !important;
    font-family: 'Cormorant Garamond', serif !important;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  .full-width-divider {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--border-mahogany);
    width: 100%;
    margin-top: 2rem;
  }

/* Cinematic Video Break */
  .video-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .video-wrapper {
    width: 100%;
    height: 55vh; /* Adjust this value (e.g., 45vh to 65vh) to make it less "tall" */
    overflow: hidden;
    position: relative;
    background: transparent;
  }

  .video-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover; /* Automatically crops top/bottom or sides to fill the wrapper */
    object-position: center;
    display: block;
  }
  /* Fixed Navigation Header */
  .site-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 4rem;
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-mahogany);
    box-sizing: border-box;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin-top: 0.35rem;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-links a {
    color: var(--text-mahogany);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* Typography Fundamentals */
  h1, h2, h3 {
    font-weight: 300;
    color: var(--text-mahogany);
    margin: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin: 0.75rem 0 0 0;
  }

  .subtitle.italic {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
  }

  .body-text {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--muted-mahogany);
    font-weight: 400;
    margin: 2rem 0;
  }

  .body-text.small {
    font-size: 1.15rem;
    margin: 1rem 0 0 0;
  }

  .text-section {
    padding: 8rem 2rem;
  }

  .text-section.bordered {
    border-top: 1px solid var(--border-mahogany);
    border-bottom: 1px solid var(--border-mahogany);
    margin: 6rem 0;
  }

  .text-container.centered {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .text-container.centered h2 {
    font-size: 3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Full-Width Top Hero Slider Styling */
  .first-photo-fullwidth {
    width: 100%;
    margin-top: 72px;
    padding: 0;
    box-sizing: border-box;
  }

  .fullwidth-image-wrapper {
    width: 100%;
    position: relative;
    height: 90vh; 
    overflow: hidden;
  }

  .fullwidth-image-wrapper.hero-slider img {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .fullwidth-image-wrapper.hero-slider img.active {
    opacity: 1;
    z-index: 2;
  }

  /* General Image Layout Settings */
  .image-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .image-break.space-top {
    margin-top: 6rem;
  }

  .image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain !important;
    display: block;
    margin: 0 auto;
  }

  /* Captions */
  .caption-centered {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0; 
    border-bottom: 1px solid var(--border-mahogany);
    margin-top: 0.25rem; 
    max-width: 1600px;
    margin-left: auto;
    margin-right: auto;
    width: calc(100% - 8rem);
  }

  .caption-title {
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-mahogany);
  }

  .caption-category {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--muted-mahogany);
  }

  /* Vertical Split Layout */
  .vertical-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 8rem; 
    row-gap: 0;       
    align-items: center;
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  .vertical-layout.reverse .content-side {
    order: -1; 
  }

  .content-side h2 {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  .category-tag {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--muted-mahogany);
    margin-top: 2rem;
    border-top: 1px solid var(--border-mahogany);
    padding-top: 1rem;
    width: max-content;
  }
/* 2x3 Services Section Layout */
  .services-section {
    padding: 8rem 4rem;
    max-width: 1600px;
    margin: 0 auto;
    border-top: 1px solid var(--border-mahogany);
    border-bottom: 1px solid var(--border-mahogany);
  }

  .services-grid-2x3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    margin-top: 5rem;
  }

  .service-tile {
    position: relative;
    width: 100%;
    height: 450px; /* Adjust height of the tiles to preference */
    overflow: hidden;
    background-color: var(--text-mahogany);
  }

  .service-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Dark gradient overlay so text stays readable */
  .tile-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(36, 26, 22, 0.85) 0%, rgba(36, 26, 22, 0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem;
    box-sizing: border-box;
    transition: background 0.4s ease;
  }

  .tile-overlay h3 {
    color: var(--bg-cream);
    font-size: 2rem;
    letter-spacing: 0.1em;
    font-weight: 300;
    margin: 0;
    transition: transform 0.4s ease;
  }

  /* Hidden description by default, reveals on hover */
  .tile-description {
    color: var(--bg-cream);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0.75rem 0 0 0;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    font-weight: 300;
  }

  /* Hover Effects */
  .service-tile:hover img {
    transform: scale(1.03); /* Subtle zoom effect */
  }

  .service-tile:hover .tile-overlay {
    background: linear-gradient(to top, rgba(36, 26, 22, 0.95) 20%, rgba(36, 26, 22, 0.5) 80%, rgba(36, 26, 22, 0.3) 100%);
  }

  .service-tile:hover .tile-description {
    opacity: 1;
    transform: translateY(0);
  }

  /* Mobile responsiveness: turn into 1 column on smaller screens */
  @media (max-width: 900px) {
    .services-section {
      padding: 5rem 1.5rem;
    }
    .services-grid-2x3 {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .service-tile {
      height: 350px;
    }
    /* Always show description on mobile since hover doesn't exist */
    .tile-description {
      opacity: 1;
      transform: translateY(0);
    }
  }
  /* Double Spread (Two Verticals Side-by-Side) */
  .double-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding-top: 6rem;
  }

  .double-caption {
    margin-bottom: 6rem;
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    max-width: 1200px;
    margin: 5rem auto 0 auto;
    text-align: left;
  }

  .service-card h3 {
    font-size: 2rem;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--border-mahogany);
    padding-bottom: 1rem;
  }

  /* Footer / Contact */
  .footer-section {
    padding: 10rem 2rem 6rem 2rem;
    background-color: #F2EFE9;
    margin-top: 8rem;
  }

  .contact-details {
    margin: 4rem 0;
  }

  .contact-email {
    font-size: 2rem;
    color: var(--text-mahogany);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .contact-phone {
    font-size: 1.2rem;
    color: var(--muted-mahogany);
    letter-spacing: 0.1em;
  }

  .luxury-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin: 0 auto 5rem auto;
    max-width: 600px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text-mahogany);
  }

  .submit-btn {
    width: 100%;
    padding: 1.25rem;
    background-color: var(--text-mahogany);
    color: var(--bg-cream);
    border: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
  }

  /* Mobile Optimization */
  @media (max-width: 900px) {
    .site-nav-header {
      padding: 1rem 1.5rem;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .nav-brand {
      text-align: center;
    }

    .brand-title {
      font-size: 1.3rem;
    }

    .brand-subtitle {
      font-size: 0.58rem;
    }

    .nav-links {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .first-photo-fullwidth {
      margin-top: 110px;
    }

    .first-photo-fullwidth .caption-centered {
      width: calc(100% - 3rem);
    }

    .text-section, .footer-section {
      padding: 5rem 1.5rem;
    }

    .text-container.centered h2 {
      font-size: 2.2rem;
    }

    .body-text {
      font-size: 1.15rem;
    }

    .image-break {
      padding: 0 1.5rem;
    }

    .caption-centered {
      width: calc(100% - 3rem);
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .vertical-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .vertical-layout.reverse .content-side {
      order: 0;
    }

    .double-spread {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .contact-email {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  let heroSliderTimer;

  function initHeroSlider() {
    const wrapper = document.querySelector('.hero-slider');
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll('img');
    let currentIndex = 0;

    if (slides.length <= 1) return;

    if (heroSliderTimer) {
      clearInterval(heroSliderTimer);
    }

    heroSliderTimer = setInterval(() => {
      slides[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % slides.length;
      slides[currentIndex].classList.add('active');
    }, 4000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }

  document.addEventListener('astro:page-load', initHeroSlider);
</script>