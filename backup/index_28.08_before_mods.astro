<script>
  let heroSliderTimer;
  let portfolioCarouselTimer;

  function initHeroSlider() {
    const wrapper = document.querySelector('.hero-slider');
    if (!wrapper) return;

    const slides = wrapper.querySelectorAll('img');
    let currentIndex = 0;

    if (slides.length <= 1) return;

    if (heroSliderTimer) {
      clearInterval(heroSliderTimer);
    }

    heroSliderTimer = setInterval(() => {
      slides[currentIndex].classList.remove('active');
      currentIndex = (currentIndex + 1) % slides.length;
      slides[currentIndex].classList.add('active');
    }, 4000);
  }

  function initPortfolioCarousel() {
    const track = document.querySelector('.carousel-track');
    if (!track) return;
    
    const slides = Array.from(track.children);
    const nextBtn = document.querySelector('.next-arrow');
    const prevBtn = document.querySelector('.prev-arrow');
    
    let currentIndex = 0;

    if (slides.length <= 1) return;

    function updateSlidePosition() {
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });
      const slideWidth = slides[0].getBoundingClientRect().width;
      track.style.transform = `translateX(-${currentIndex * slideWidth}px)`;
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % slides.length;
      updateSlidePosition();
    }

    function prevSlide() {
      currentIndex = (currentIndex - 1 + slides.length) % slides.length;
      updateSlidePosition();
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        nextSlide();
        resetTimer();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        prevSlide();
        resetTimer();
      });
    }

    function startTimer() {
      portfolioCarouselTimer = setInterval(nextSlide, 4000);
    }

    function resetTimer() {
      clearInterval(portfolioCarouselTimer);
      startTimer();
    }

    if (portfolioCarouselTimer) {
      clearInterval(portfolioCarouselTimer);
    }

    startTimer();
    window.addEventListener('resize', updateSlidePosition);
    updateSlidePosition();
  }

  function initAll() {
    initHeroSlider();
    initPortfolioCarousel();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

  document.addEventListener('astro:page-load', initAll);
</script>