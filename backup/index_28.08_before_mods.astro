---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Lightworks | Editorial Portfolio">
  <div class="page-wrapper">
    
    <header class="site-nav-header">
      <div class="nav-brand">
        <span class="brand-title">THE LIGHTWORKS</span>
        <span class="brand-subtitle">ARCHITECTURAL & REAL ESTATE MEDIA</span>
      </div>
      <nav class="nav-links">
        <a href="#home">HOME</a>
        <a href="#about">ABOUT</a>
        <a href="#services">SERVICES</a>
        <a href="#portfolio">PORTFOLIO</a>
        <a href="#contact">CONTACT</a>
      </nav>
    </header>

    <section class="first-photo-fullwidth" id="home">
      <div class="fullwidth-image-wrapper hero-slider">
        <img 
          class="active" 
          src="/images/DSC08582-HDR-Export.jpg" 
          alt="The Woodland Spa Estate" 
        />
        <img 
          src="/images/DSC08537-HDR-Export.jpg" 
          alt="The Concrete Horizon" 
        />
        <img 
          src="/images/DSC08642-HDR-Export.jpg" 
          alt="Spatial Fluidity" 
        />
      </div>

      <div class="caption-centered">
          &nbsp;
      </div>
    </section>

    <section class="image-break vertical-layout" id="about">
      <div class="image-wrapper">
        <img src="/images/DSC08975-HDR-Export.jpg" alt="Minimalist Interior Volume" />
      </div>
      <div class="content-side">
        <h2>ABOUT</h2>
        <p class="body-text">
          We are dedicated to creating exceptional, editorial-style architectural imagery and real estate media. Working closely with our clients, we tailor every capture to align with the unique vision and character of the property.
        </p>
        <p class="body-text">
          Our approach is centered on natural light—how it enters, interacts with, and elevates spatial design. From high-resolution photography to immersive videography, we provide comprehensive media solutions tailored to your complete project needs.
        </p>
      </div>

      <div class="full-width-divider"></div>
    </section>

    <section class="video-break" id="video">
      <div class="video-wrapper">
        <video autoplay muted loop playsinline preload="auto">
          <source src="/videos/architectural-reel.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </section>

    <section class="services-section" id="services">
      <div class="text-container centered">
        <h2>Services</h2>
        <p class="subtitle italic">The Lightworks delivers premium property marketing tailored for estate agents, developers, interior designers, and private clients. We present every space with clarity and style, creating an engaging digital presence that elevates its true value.</p>
      </div>

      <div class="services-grid-2x3">
        <div class="service-tile">
          <img src="/images/DSC08582-HDR-Export.jpg" alt="Architectural Photography" />
          <div class="tile-overlay">
            <h3>Photography</h3>
            <p class="tile-description">Meticulously composed stills emphasizing texture, spatial flow, and natural daylight.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08537-HDR-Export.jpg" alt="Architectural Videography" />
          <div class="tile-overlay">
            <h3>Videography</h3>
            <p class="tile-description">Cinematic walkthroughs highlighting the true atmosphere and flow of luxury spaces.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08642-HDR-Export.jpg" alt="Drone Media" />
          <div class="tile-overlay">
            <h3>Drone</h3>
            <p class="tile-description">Elevated aerial views showcasing the property layout and surrounding landscape context.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08785-HDR-Export.jpg" alt="Floorplans" />
          <div class="tile-overlay">
            <h3>Floorplans</h3>
            <p class="tile-description">Precise, professional 2D and 3D schematics mapping accurate spatial dimensions.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08930-HDR-Export.jpg" alt="360 Tours" />
          <div class="tile-overlay">
            <h3>360 Tours</h3>
            <p class="tile-description">Interactive digital environments allowing seamless remote exploration of the property.</p>
          </div>
        </div>

        <div class="service-tile">
          <img src="/images/DSC08975-HDR-Export.jpg" alt="Social Media Content" />
          <div class="tile-overlay">
            <h3>Social Media</h3>
            <p class="tile-description">Engaging, short-form visual content optimized for digital marketing and high-end reach.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio-carousel-section" id="portfolio">
      <div class="text-container centered">
        <h2>Portfolio</h2>
        <p class="subtitle italic">Selected architectural and Real Estate work</p>
      </div>

      <div class="carousel-container">
        <button class="carousel-arrow prev-arrow" aria-label="Previous slide">&#10094;</button>
        <div class="carousel-track-wrapper">
          <div class="carousel-track">
            <div class="carousel-slide active">
              <img src="/images/DSC08587-HDR-Export.jpg" alt="Penthouse Proportion" />
            </div>
            <div class="carousel-slide">
              <img src="/images/DSC08763-HDR-Export.jpg" alt="Diffused Light" />
            </div>
            <div class="carousel-slide">
              <img src="/images/DSC08868-HDR-Export.jpg" alt="Textural Harmony" />
            </div>
            <div class="carousel-slide">
              <img src="/images/DSC08990-HDR-Export.jpg" alt="Evening Atmosphere" />
            </div>
          </div>
        </div>
        <button class="carousel-arrow next-arrow" aria-label="Next slide">&#10095;</button>
      </div>
    </section>

    <footer class="footer-section" id="contact">
      <div class="text-container centered">
        <h2>Contact</h2>
        <p class="subtitle italic">Connect with us through the channels below or submit your details via the form.</p>
        
        <div class="contact-details">
          <a href="mailto:enquiries@thelightworks.art" class="contact-email">enquiries@thelightworks.art</a>
          <p class="contact-phone">+44 (0) 7376 940 650</p>
        </div>

        <form class="luxury-form" onsubmit="event.preventDefault();">
          <div class="form-group">
            <input type="text" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <input type="email" placeholder="Your Email Address" required />
          </div>
          <div class="form-group">
            <textarea placeholder="Project Details & Location" rows="4" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Enquiry</button>
        </form>
        
        <p class="copyright">&copy; 2026 The Lightworks. All Rights Reserved.</p>
      </div>
    </footer>

  </div>
</Layout>

<style>
  :root {
    --bg-cream: #F9F6F0;
    --text-mahogany: #241A16;
    --muted-mahogany: #63524A;
    --border-mahogany: rgba(36, 26, 22, 0.15);
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-cream) !important;
    overflow-x: hidden;
  }

  body {
    background-color: var(--bg-cream) !important;
    color: var(--text-mahogany) !important;
    font-family: 'Cormorant Garamond', serif !important;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    width: 100%;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  .page-wrapper {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Cinematic Video Break */
  .video-break {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    margin-top: -3.7rem;
    padding: 0;
  }

  .video-wrapper {
    width: 100%;
    height: 80vh;
    overflow: hidden;
    position: relative;
  }

  .video-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Fixed Navigation Header */
  .site-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 4rem;
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-mahogany);
    box-sizing: border-box;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin-top: 0.35rem;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-links a {
    color: var(--text-mahogany);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* Typography Fundamentals */
  h1, h2, h3 {
    font-weight: 300;
    color: var(--text-mahogany);
    margin: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin: 0.75rem 0 0 0;
  }

  .subtitle.italic {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
  }

  .body-text {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--muted-mahogany);
    font-weight: 400;
    margin: 2rem 0;
  }

  .text-container.centered {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .text-container.centered h2 {
    font-size: 3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Full-Width Top Hero Slider Styling */
  .first-photo-fullwidth {
    width: 100%;
    margin-top: 95px;
    padding: 0;
    box-sizing: border-box;
  }

  .fullwidth-image-wrapper {
    width: 100%;
    position: relative;
    height: 90vh; 
    overflow: hidden;
  }

  .fullwidth-image-wrapper.hero-slider img {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .fullwidth-image-wrapper.hero-slider img.active {
    opacity: 1;
    z-index: 2;
  }

  /* General Image Layout Settings */
  .image-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  /* Captions */
  .caption-centered {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0; 
    border-bottom: 1px solid var(--border-mahogany);
    margin-top: 0.25rem; 
    max-width: 1600px;
    margin-left: auto;
    margin-right: auto;
    width: calc(100% - 8rem);
  }

  /* Flexbox Split Layout for About Section (Desktop) */
  .vertical-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5rem;
    padding-top: 3rem;
    padding-bottom: 6rem;
    box-sizing: border-box;
  }

  .vertical-layout .image-wrapper {
    flex: 0 0 35%;
    max-width: 35%;
  }

  .vertical-layout .image-wrapper img {
    width: 100% !important;
    height: auto !important;
    max-height: 75vh;
    object-fit: contain !important;
    display: block;
    margin: 0;
  }

  .vertical-layout .content-side {
    flex: 1;
    min-width: 0;
  }

  .content-side h2 {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  .vertical-layout .full-width-divider {
    flex: 0 0 100%;
    border-bottom: 1px solid var(--border-mahogany);
    width: 100%;
    margin-top: 2rem;
  }

/* 2x3 Services Section Layout */
  .services-section {
    padding: 2rem 2rem;
    max-width: 1200px; /* Reduced from 1600px to make the columns narrower */
    margin: 0 auto;
    border-top: 1px solid var(--border-mahogany);
    border-bottom: 1px solid var(--border-mahogany);
  }

  .services-grid-2x3 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    margin-top: 2rem;
  }

  .service-tile {
    position: relative;
    width: 100%;
    height: 350px; /* Reduced from 450px to make the tiles shorter */
    overflow: hidden;
    background-color: var(--text-mahogany);
  }

  .service-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(36, 26, 22, 0.85) 0%, rgba(36, 26, 22, 0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem;
    box-sizing: border-box;
    transition: background 0.4s ease;
  }

  .tile-overlay h3 {
    color: var(--bg-cream);
    font-size: 2rem;
    letter-spacing: 0.1em;
    font-weight: 300;
    margin: 0;
  }

  .tile-description {
    color: var(--bg-cream);
    font-size: 1.15rem;
    line-height: 1.6;
    margin: 0.75rem 0 0 0;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    font-weight: 300;
  }

  .service-tile:hover img {
    transform: scale(1.03);
  }

  .service-tile:hover .tile-overlay {
    background: linear-gradient(to top, rgba(36, 26, 22, 0.95) 20%, rgba(36, 26, 22, 0.5) 80%, rgba(36, 26, 22, 0.3) 100%);
  }

  .service-tile:hover .tile-description {
    opacity: 1;
    transform: translateY(0);
  }

  /* Portfolio Carousel Styles */
  .portfolio-carousel-section {
    padding: 1rem 0 2rem 0;
    border-bottom: 1px solid var(--border-mahogany);
    background-color: var(--bg-cream);
  }

  .carousel-container {
    position: relative;
    width: 100%;
    max-width: 1600px;
    margin: 1.5rem auto 0 auto;
    display: flex;
    align-items: center;
  }

  .carousel-track-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 0 20%;
    box-sizing: border-box;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .carousel-slide {
    min-width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0 1rem;
    opacity: 0.4;
    transform: scale(0.95);
    transition: transform 0.6s ease, opacity 0.6s ease;
  }

  .carousel-slide.active {
    opacity: 1;
    transform: scale(1);
  }

  .carousel-slide img {
    width: 100%;
    height: 70vh;
    object-fit: cover;
    display: block;
  }

  .carousel-arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    background: var(--bg-cream);
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-size: 1.5rem;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.3s, color 0.3s;
  }

  .carousel-arrow:hover {
    background: var(--text-mahogany);
    color: var(--bg-cream);
  }

  .prev-arrow {
    left: 2rem;
  }

  .next-arrow {
    right: 2rem;
  }

  /* Footer / Contact */
  .footer-section {
    padding: 2rem 2rem 6rem 2rem;
    background-color: #F2EFE9;
    margin-top: 2rem;
  }

  .contact-details {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .contact-email {
    font-size: 2rem;
    color: var(--text-mahogany);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .contact-phone {
    font-size: 1.2rem;
    color: var(--muted-mahogany);
    letter-spacing: 0.1em;
  }

  .luxury-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin: 0 auto 5rem auto;
    max-width: 600px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text-mahogany);
  }

  .submit-btn {
    width: 100%;
    padding: 1.25rem;
    background-color: var(--text-mahogany);
    color: var(--bg-cream);
    border: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
  }

  /* ==========================================
     MOBILE OPTIMIZATION
     ========================================== */
@media (max-width: 768px) {
    /* 1. Reset Global Horizontal Overflow */
    body, html, .page-wrapper {
      overflow-x: hidden !important;
      width: 100% !important;
      max-width: 100vw !important;
    }

    /* 2. Header - Forced Single Line Navigation */
    .site-nav-header {
      padding: 1rem 0.5rem !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 1rem !important;
      box-sizing: border-box !important;
    }

    .nav-brand {
      align-items: center !important;
      text-align: center !important;
    }

    .nav-brand .brand-title {
      font-size: 1.15rem !important;
      letter-spacing: 0.1em !important;
    }

    .nav-brand .brand-subtitle {
      font-size: 0.55rem !important;
      letter-spacing: 0.15em !important;
      margin-top: 0.3rem !important;
    }

    .nav-links {
      display: flex !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      gap: 0.75rem !important;
      width: 100% !important;
    }

    .nav-links a {
      font-size: 0.65rem !important;
      letter-spacing: 0.1em !important;
      padding: 0 !important;
      white-space: nowrap !important;
    }

    /* 3. Top Hero Section - 16:9 Aspect Ratio */
    .first-photo-fullwidth {
      margin-top: 130px !important;
      margin-bottom: 0 !important;
      padding-bottom: 0 !important;
    }

    .fullwidth-image-wrapper.hero-slider {
      aspect-ratio: 16 / 9 !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin-bottom: 0 !important;
    }

    /* FULL WIDTH LINE: Underneath the Hero Image */
    .caption-centered {
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      border-bottom: 1px solid var(--border-mahogany) !important;
      padding: 0 !important;
      height: 0 !important;
    }

    /* 4. UNIFIED SECTION TITLES: About, Services, Portfolio, Contact */
    .vertical-layout .content-side h2,
    .services-section .text-container.centered h2,
    .portfolio-carousel-section .text-container.centered h2,
    .footer-section .text-container.centered h2 {
      grid-column: 1 / -1 !important; 
      font-size: 1.25rem !important; 
      letter-spacing: 0.2em !important; 
      text-transform: uppercase !important; 
      text-align: center !important; 
      font-weight: 300 !important;
      margin: 0 auto 1.5rem auto !important; 
      padding: 0 !important;
      width: 100% !important;
    }

    /* 5. About Section - Centered Heading & Grid Alignment */
    .image-break {
      padding: 0 1rem !important;
      margin: 0 !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .vertical-layout {
      display: grid !important;
      grid-template-columns: 38% 57% !important;
      column-gap: 5% !important;
      row-gap: 0 !important; 
      align-items: start !important;
      padding: 2rem 0 0 0 !important; /* Top gap dropping down from the horizontal line */
      margin: 0 !important; 
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .vertical-layout .image-wrapper {
      grid-column: 1 !important;
      grid-row: 2 / 10 !important;
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .vertical-layout .image-wrapper img {
      width: 100% !important;
      height: auto !important;
      max-height: none !important;
      display: block !important;
    }

    .vertical-layout .content-side {
      display: contents !important;
    }

    .vertical-layout .body-text {
      grid-column: 2 !important;
      font-size: 0.8rem !important;
      line-height: 1.35 !important; 
      margin: 0 0 0.6rem 0 !important; 
      padding: 0 !important;
      white-space: normal !important;
      word-break: normal !important; 
      overflow-wrap: normal !important;
    }

    .vertical-layout .body-text:first-of-type {
      margin-top: 0 !important;
    }

    /* FULL WIDTH LINE: Between About & Video */
    .vertical-layout .full-width-divider {
      grid-column: 1 / -1 !important;
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      border-bottom: 1px solid var(--border-mahogany) !important;
      margin-top: 2rem !important;    /* Gap below the About content */
      margin-bottom: 1.5rem !important; /* Gap above the Video */
      padding: 0 !important;
      height: 0 !important;
    }

    /* 6. Video Break - 16:9 Aspect Ratio & Bottom Divider */
    .video-break {
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
      margin-top: 0 !important;
      margin-bottom: 1.5rem !important; /* Gap below the video */
