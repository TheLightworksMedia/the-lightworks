---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Airbnb & Short-Term Rental Photography Bristol | The Lightworks"
  description="Elevate your Airbnb or holiday let with architectural-grade photography, walk-through videos, and 360 tours. Based in Bristol, serving the South West. Packages from £199."
>
  <div class="page-wrapper">
    
    <!-- SUBPAGE HERO -->
    <section class="subpage-hero" id="home">
      <div class="fullwidth-image-wrapper">
        <picture>
          <source media="(max-width: 768px)" srcset="/images/Portfolio/Portfolio_1080p_004.JPG" />
          <img src="/images/Portfolio/Portfolio_2000p_004.JPG" alt="Luxury Short Term Rental Interior Bristol" />
        </picture>
        <div class="hero-overlay-text">
          <h1>Short-Term Rentals & Holiday Lets</h1>
          <p class="subtitle italic" style="color: #F9F6F0;">Maximizing bookings through exceptional visual storytelling.</p>
        </div>
      </div>
    </section>

    <!-- INTRO PHILOSOPHY -->
    <section class="image-break vertical-layout" style="padding-top: 5rem;">
      <div class="content-side" style="padding-right: 2rem;">
        <h2>ELEVATE YOUR LISTING</h2>
        <p class="body-text">
          In a highly competitive market, your property’s imagery is your single most valuable asset. We capture your space to highlight its unique character, showcase key features, and reflect the time, love, and investment you've dedicated to creating the perfect getaway.
        </p>
        <p class="body-text">
          We work intimately with hosts, property managers, and interior designers to understand the distinct vision of the property. The result is a curated gallery that stops the scroll, builds instant trust with guests, and allows you to command premium nightly rates.
        </p>
      </div>
      <div class="image-wrapper">
        <img src="/images/Grid/Grid_900p_007.JPG" alt="Boutique Airbnb Photography Details" />
      </div>
      <div class="full-width-divider"></div>
    </section>

    <!-- COMPREHENSIVE SERVICES -->
    <section class="str-services-section">
      <div class="text-container centered" style="margin-bottom: 4rem;">
        <h2>The Complete Marketing Suite</h2>
        <p class="body-text" style="text-wrap: balance; max-width: 700px; margin: 1.5rem auto 0 auto;">
          We offer a comprehensive set of media services to meet your full marketing needs across booking platforms (Airbnb, Vrbo, Booking.com) and your own direct-booking social channels.
        </p>
      </div>

      <div class="str-services-grid">
        <div class="str-service-column">
          <h3>Core Imagery</h3>
          <ul class="editorial-list">
            <li><strong>Architectural-Grade Photography:</strong> Wide, bright, and perfectly balanced shots of all primary spaces.</li>
            <li><strong>Detail & Lifestyle Vignettes:</strong> Close-ups of amenities, textures, and styling that sell the "experience."</li>
            <li><strong>Neighborhood Context:</strong> Exterior and surrounding area photography to showcase location appeal.</li>
          </ul>
        </div>

        <div class="str-service-column">
          <h3>Video & Immersive</h3>
          <ul class="editorial-list">
            <li><strong>Cinematic Highlight Videos:</strong> High-end, emotional video reels designed to captivate viewers.</li>
            <li><strong>Seamless Walkthroughs:</strong> Smooth, stabilized video tours giving guests a true sense of layout.</li>
            <li><strong>360° Virtual Tours:</strong> Immersive digital environments for premium and luxury listings.</li>
            <li><strong>Aerial Drone Media:</strong> Elevated photo and video to showcase the property's footprint and views.</li>
          </ul>
        </div>

        <div class="str-service-column">
          <h3>Styling & Social</h3>
          <ul class="editorial-list">
            <li><strong>Light Staging & Styling:</strong> Expert adjustments on-site to ensure every room looks inviting and magazine-ready.</li>
            <li><strong>Virtual AI Staging:</strong> Photorealistic digital furnishing and decoration applied in post-production to bring empty spaces to life.</li>
            <li><strong>Social Media Content:</strong> Custom vertical video formatting (Reels/TikToks) to drive direct bookings via Instagram.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PRICING & CTA BANNER -->
    <section class="pricing-banner">
      <div class="text-container centered">
        <h2 style="color: #F9F6F0;">Tailored to Your Space</h2>
        <p class="body-text" style="color: rgba(249, 246, 240, 0.85); text-wrap: balance; max-width: 600px; margin: 1.5rem auto 2.5rem auto;">
          Whether you are launching a cozy city studio or a sprawling countryside retreat, we build custom media packages suited to your exact requirements. 
        </p>
        <p class="pricing-highlight">Packages starting from&nbsp;£199.</p>
      </div>
    </section>

    <!-- CONTACT FOOTER -->
    <footer class="footer-section" id="contact">
      <div class="text-container centered">
        <h2>Get in Touch</h2>
        <p class="subtitle italic">Request a personalized quote for your rental property.</p>
        
        <div class="contact-details">
          <a href="mailto:enquiries@thelightworks.art" class="contact-email">enquiries@thelightworks.art</a>
        </div>

        <form class="luxury-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="d8c351b8-59e4-4c99-9236-ecd105a16121">
          <div class="form-group">
            <input type="text" name="name" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Your Email Address" required />
          </div>
          <div class="form-group">
            <textarea name="message" placeholder="Property Link (if live), Location, and Required Services" rows="4" required></textarea>
          </div>
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
          <button type="submit" class="submit-btn">Send Enquiry</button>
        </form>
        
        <p class="copyright">&copy; 2026 The Lightworks. All Rights Reserved.</p>
      </div>
    </footer>

  </div>
</Layout>

<style>
  :root {
    --bg-cream: #F9F6F0;
    --text-mahogany: #241A16;
    --muted-mahogany: #63524A;
    --border-mahogany: rgba(36, 26, 22, 0.15);
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-cream) !important;
    overflow-x: hidden;
  }

  section, footer {
    scroll-margin-top: 80px; 
  }

  body {
    background-color: var(--bg-cream) !important;
    color: var(--text-mahogany) !important;
    font-family: 'Cormorant Garamond', serif !important;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    width: 100%;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  .page-wrapper {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Fixed Navigation Header */
  .site-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 4rem;
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-mahogany);
    box-sizing: border-box;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin-top: 0.35rem;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-links a {
    color: var(--text-mahogany);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* Typography */
  h1, h2, h3 {
    font-weight: 300;
    color: var(--text-mahogany);
    margin: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin: 0.75rem 0 0 0;
  }

  .subtitle.italic {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
  }

  .body-text {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--muted-mahogany);
    font-weight: 400;
    margin: 2rem 0;
  }

  .text-container.centered {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .text-container.centered h2 {
    font-size: 3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Subpage Hero */
  .subpage-hero {
    width: 100%;
    margin-top: 95px;
    padding: 0;
    box-sizing: border-box;
  }

  .subpage-hero .fullwidth-image-wrapper {
    width: 100%;
    position: relative;
    height: 60vh; 
    overflow: hidden;
    background-color: var(--text-mahogany);
  }

  .subpage-hero img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.7; /* Darkens image slightly so text pops */
  }

  .hero-overlay-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    max-width: 1000px;
    z-index: 2;
  }

  .hero-overlay-text h1 {
    color: #F9F6F0;
    font-size: 4rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 4px 20px rgba(0,0,0,0.4);
    text-wrap: balance;
  }

  /* Split Layout */
  .image-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .vertical-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5rem;
    padding-bottom: 4rem;
    box-sizing: border-box;
  }

  .vertical-layout .image-wrapper {
    flex: 0 0 40%;
    max-width: 40%;
  }

  .vertical-layout .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .vertical-layout .content-side {
    flex: 1;
    min-width: 0;
  }

  .content-side h2 {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  .full-width-divider {
    flex: 0 0 100%;
    border-bottom: 1px solid var(--border-mahogany);
    width: 100%;
    margin-top: 2rem;
  }

  /* STR Services Grid */
  .str-services-section {
    padding: 4rem 4rem 6rem 4rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .str-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  .str-service-column h3 {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-mahogany);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .editorial-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .editorial-list li {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted-mahogany);
    margin-bottom: 1.5rem;
  }

  .editorial-list li strong {
    color: var(--text-mahogany);
    font-weight: 400;
    display: block;
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }

  /* Pricing Banner */
  .pricing-banner {
    background-color: var(--text-mahogany);
    padding: 6rem 2rem;
    text-align: center;
  }

  .pricing-highlight {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
    color: #F9F6F0;
    text-transform: uppercase;
    font-weight: 300;
    border: 1px solid rgba(249, 246, 240, 0.3);
    display: inline-block;
    padding: 1.5rem 3rem;
  }

  /* Footer / Contact */
  .footer-section {
    padding: 4rem 2rem 6rem 2rem;
    background-color: #F2EFE9;
  }

  .contact-details {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .contact-email {
    font-size: 2rem;
    color: var(--text-mahogany);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .luxury-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin: 0 auto 5rem auto;
    max-width: 600px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text-mahogany);
  }

  .submit-btn {
    width: 100%;
    padding: 1.25rem;
    background-color: var(--text-mahogany);
    color: var(--bg-cream);
    border: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
  }

  /* ==========================================
     MOBILE OPTIMIZATION
     ========================================== */
@media (max-width: 768px) {
    body, html, .page-wrapper {
      overflow-x: hidden !important;
      width: 100% !important;
    }

    section, footer {
      scroll-margin-top: 115px; 
    }

    .site-nav-header {
      padding: 1rem 0.5rem !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 1rem !important;
    }

    .nav-brand {
      align-items: center !important;
      text-align: center !important;
    }

    .nav-brand .brand-title {
      font-size: 1.15rem !important;
    }

    .nav-brand .brand-subtitle {
      font-size: 0.55rem !important;
      margin-top: 0.3rem !important;
    }

    .nav-links {
      gap: 1.5rem !important;
    }

    .nav-links a {
      font-size: 0.65rem !important;
    }

    .subpage-hero {
      margin-top: 130px !important;
    }

    .subpage-hero .fullwidth-image-wrapper {
      height: 45vh !important;
    }

    .hero-overlay-text h1 {
      font-size: 2rem !important;
    }

    .hero-overlay-text .subtitle {
      font-size: 0.85rem !important;
      margin-top: 1rem !important;
    }

    .image-break {
      padding: 0 1rem !important;
    }

    .vertical-layout {
      display: flex !important;
      flex-direction: column !important;
      gap: 2rem !important;
      padding-top: 2.5rem !important;
    }

    .vertical-layout .content-side {
      padding-right: 0 !important;
    }

    .vertical-layout .content-side h2 {
      font-size: 1.5rem !important;
      text-align: center !important;
      margin-bottom: 1.5rem !important;
    }

    .vertical-layout .body-text {
      font-size: 0.9rem !important;
      line-height: 1.5 !important;
      margin-bottom: 1rem !important;
    }

    .vertical-layout .image-wrapper {
      width: 100% !important;
      max-width: 100% !important;
    }

    .full-width-divider {
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
    }

    .str-services-section {
      padding: 2rem 1rem 4rem 1rem !important;
    }

    .str-services-section .text-container.centered h2 {
      font-size: 1.5rem !important;
    }

    .str-services-section .body-text {
      font-size: 0.9rem !important;
      line-height: 1.5 !important;
    }

    .str-services-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }

    .str-service-column h3 {
      font-size: 1.25rem !important;
    }

    .editorial-list li {
      font-size: 0.9rem !important;
    }

    .editorial-list li strong {
      font-size: 1.05rem !important;
    }

    .pricing-banner {
      padding: 4rem 1rem !important;
    }

    .pricing-banner h2 {
      font-size: 1.75rem !important;
    }

    .pricing-banner .body-text {
      font-size: 0.9rem !important;
    }

    .pricing-highlight {
      font-size: 1.5rem !important;
      padding: 1rem 1.5rem !important;
    }

    .footer-section {
      padding: 2.5rem 1rem 3rem 1rem !important; 
    }

    .footer-section .text-container.centered h2 {
      font-size: 1.5rem !important;
    }

    .footer-section .text-container.centered .subtitle {
      font-size: 0.8rem !important;
      margin-bottom: 1.5rem !important;
    }

    .contact-email {
      font-size: 1.25rem !important;
    }

    .luxury-form {
      gap: 1rem !important; 
      margin-bottom: 2rem !important;
    }

    .form-group input,
    .form-group textarea,
    .submit-btn {
      padding: 1rem !important; 
      font-size: 0.9rem !important; 
    }
  }
</style>