---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Lightworks | Editorial Portfolio">
  <div class="page-wrapper">
    
    <header class="site-nav-header">
      <div class="nav-brand">The Lightworks</div>
      <nav class="nav-links">
        <a href="#home">Home</a>
        <a href="#portfolio">Portfolio</a>
        <a href="#about">About</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section class="hero-section" id="home">
      <h1>The Lightworks</h1>
      <p class="subtitle">Architectural & Real Estate Media</p>
    </section>

    <div id="portfolio">
      <section class="image-break landscape first-photo">
        <div class="image-wrapper">
          <img src="/images/DSC08582-HDR-Export.jpg" alt="The Pavilion Residence Exterior" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">The Pavilion Residence</span>
          <span class="caption-category">Exterior Architecture</span>
        </div>
      </section>

      <section class="text-section" id="about">
        <div class="text-container centered">
          <h2>A Study in Light</h2>
          <p class="body-text">
            Founded on the principle that exceptional architecture deserves an equally uncompromising visual expression, The Lightworks operates at the intersection of fine art photography and high-end real estate media. We treat every structure as a sculpture of light and shadow, delivering a timeless editorial standard.
          </p>
        </div>
      </section>

      <section class="image-break vertical-layout">
        <div class="image-wrapper">
          <img src="/images/DSC08975-HDR-Export.jpg" alt="Minimalist Interior Volume" />
        </div>
        <div class="content-side">
          <h2>Monochrome Volume</h2>
          <p class="body-text">
            A minimalist study in negative space and architectural structure, captured through a high-end editorial lens to reveal the precise craft of modern interior design.
          </p>
          <span class="category-tag">Interior & Spatial Design</span>
        </div>
      </section>

      <section class="image-break landscape">
        <div class="image-wrapper">
          <img src="/images/DSC08537-HDR-Export.jpg" alt="Structural Light Study" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">The Concrete Horizon</span>
          <span class="caption-category">Structural Architecture</span>
        </div>
      </section>

      <section class="image-break double-spread">
        <div class="image-wrapper">
          <img src="/images/DSC08785-HDR-Export.jpg" alt="Architectural Detail Shot Left" />
        </div>
        <div class="image-wrapper">
          <img src="/images/DSC08930-HDR-Export.jpg" alt="Architectural Detail Shot Right" />
        </div>
      </section>
      <div class="caption-centered double-caption">
        <span class="caption-title">Material & Spatial Studies</span>
        <span class="caption-category">Detail Curation</span>
      </div>

      <section class="image-break landscape">
        <div class="image-wrapper">
          <img src="/images/DSC08642-HDR-Export.jpg" alt="Open Living Space Geometry" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Spatial Fluidity</span>
          <span class="caption-category">Interior Horizon</span>
        </div>
      </section>
    </div>

    <section class="text-section bordered" id="services">
      <div class="text-container centered">
        <h2>Curated Services</h2>
        <p class="subtitle italic">Meticulous documentation for the built environment</p>
      </div>
      
      <div class="services-grid">
        <div class="service-card">
          <h3>Architectural</h3>
          <p class="body-text small">Meticulously composed visual documentation for architects, emphasizing geometry, materials, and spatial atmosphere.</p>
        </div>
        <div class="service-card">
          <h3>Real Estate</h3>
          <p class="body-text small">High-end editorial imagery tailored for luxury properties, boutique developers, and interior designers.</p>
        </div>
        <div class="service-card">
          <h3>Motion</h3>
          <p class="body-text small">Sophisticated cinematic video designed to capture the true fluidity and ambiance of high-end architectural spaces.</p>
        </div>
      </div>
    </section>

    <div class="portfolio-continuation">
      <section class="image-break vertical-layout reverse">
        <div class="image-wrapper">
          <img src="/images/DSC08587-HDR-Export.jpg" alt="Urban Luxury Living Vertical" />
        </div>
        <div class="content-side">
          <h2>Penthouse Proportion</h2>
          <p class="body-text">
            Balancing natural daylight with structural integrity, this composition emphasizes height, luxury texture, and spatial clarity for high-end portfolio curation.
          </p>
          <span class="category-tag">Luxury Editorial</span>
        </div>
      </section>

      <section class="image-break landscape">
        <div class="image-wrapper">
          <img src="/images/DSC08763-HDR-Export.jpg" alt="Bright Spatial Photography" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Diffused Light</span>
          <span class="caption-category">Luminous Interiors</span>
        </div>
      </section>

      <section class="image-break landscape space-top">
        <div class="image-wrapper">
          <img src="/images/DSC08868-HDR-Export.jpg" alt="Interior Geometry and Texture" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Textural Harmony</span>
          <span class="caption-category">Residential Curation</span>
        </div>
      </section>

      <section class="image-break landscape space-top">
        <div class="image-wrapper">
          <img src="/images/DSC08990-HDR-Export.jpg" alt="Twilight Architecture Exterior" />
        </div>
        <div class="caption-centered">
          <span class="caption-title">Evening Atmosphere</span>
          <span class="caption-category">Twilight Ambiance</span>
        </div>
      </section>
    </div>

    <footer class="footer-section" id="contact">
      <div class="text-container centered">
        <h2>Inquiries</h2>
        <p class="subtitle italic">For commissioning and collaborative rates</p>
        
        <div class="contact-details">
          <a href="mailto:info@thelightworks.art" class="contact-email">info@thelightworks.art</a>
          <p class="contact-phone">+44 (0) 20 7946 0912</p>
        </div>

        <form class="luxury-form" onsubmit="event.preventDefault();">
          <div class="form-group">
            <input type="text" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <input type="email" placeholder="Your Email Address" required />
          </div>
          <div class="form-group">
            <textarea placeholder="Project Details & Location" rows="4" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Inquiry</button>
        </form>
        
        <p class="copyright">&copy; 2026 The Lightworks. All Rights Reserved.</p>
      </div>
    </footer>

  </div>
</Layout>

<style>
  /* Import Cormorant Garamond font from Google Fonts */
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&display=swap');

  :root {
    --bg-cream: #F9F6F0;
    --text-mahogany: #241A16;
    --muted-mahogany: #63524A;
    --border-mahogany: rgba(36, 26, 22, 0.15);
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-cream) !important;
  }

  body {
    background-color: var(--bg-cream) !important;
    color: var(--text-mahogany) !important;
    font-family: 'Cormorant Garamond', serif !important;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  .page-wrapper {
    background-color: var(--bg-cream);
    min-height: 100vh;
    width: 100%;
  }

  /* Fixed Navigation Header - Stays pinned at top */
  .site-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 4rem;
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-mahogany);
    box-sizing: border-box;
  }

  .nav-brand {
    font-size: 1.2rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
  }

  .nav-links {
    display: flex;
    gap: 3rem;
  }

  .nav-links a {
    color: var(--text-mahogany);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* Typography Fundamentals */
  h1, h2, h3 {
    font-weight: 300;
    color: var(--text-mahogany);
    margin: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin: 0.75rem 0 0 0;
  }

  .subtitle.italic {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
  }

  .body-text {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--muted-mahogany);
    font-weight: 400;
    margin: 2rem 0;
  }

  .body-text.small {
    font-size: 1.15rem;
    margin: 1rem 0 0 0;
  }

  /* Hero Section - Zero bottom padding/margin to pull image directly up */
  .hero-section {
    text-align: center;
    padding-top: 8rem; /* Account for fixed navigation header */
    padding-bottom: 2rem;
    margin-bottom: 0;
  }

  .hero-section h1 {
    font-size: 4.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .text-section {
    padding: 8rem 2rem;
  }

  .text-section.bordered {
    border-top: 1px solid var(--border-mahogany);
    border-bottom: 1px solid var(--border-mahogany);
    margin: 6rem 0;
  }

  .text-container.centered {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .text-container.centered h2 {
    font-size: 3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Image Layout Settings */
  .image-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .image-break.first-photo {
    margin-top: 0;
  }

  .image-break.space-top {
    margin-top: 6rem;
  }

  .image-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain !important;
    display: block;
    margin: 0 auto;
  }

  /* Captions */
  .caption-centered {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-mahogany);
    margin-top: 1rem;
    max-width: 1600px;
    margin-left: auto;
    margin-right: auto;
    width: calc(100% - 8rem);
  }

  .caption-title {
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-mahogany);
  }

  .caption-category {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--muted-mahogany);
  }

  /* Vertical Split Layout */
  .vertical-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8rem;
    align-items: center;
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .vertical-layout.reverse .content-side {
    order: -1; 
  }

  .content-side h2 {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  .category-tag {
    display: block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--muted-mahogany);
    margin-top: 2rem;
    border-top: 1px solid var(--border-mahogany);
    padding-top: 1rem;
    width: max-content;
  }

  /* Double Spread (Two Verticals Side-by-Side) */
  .double-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    padding-top: 6rem;
  }

  .double-caption {
    margin-bottom: 6rem;
  }

  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
    max-width: 1200px;
    margin: 5rem auto 0 auto;
    text-align: left;
  }

  .service-card h3 {
    font-size: 2rem;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--border-mahogany);
    padding-bottom: 1rem;
  }

  /* Footer / Contact */
  .footer-section {
    padding: 10rem 2rem 6rem 2rem;
    background-color: #F2EFE9;
    margin-top: 8rem;
  }

  .contact-details {
    margin: 4rem 0;
  }

  .contact-email {
    font-size: 2rem;
    color: var(--text-mahogany);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .contact-phone {
    font-size: 1.2rem;
    color: var(--muted-mahogany);
    letter-spacing: 0.1em;
  }

  .luxury-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin: 0 auto 5rem auto;
    max-width: 600px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text-mahogany);
  }

  .submit-btn {
    width: 100%;
    padding: 1.25rem;
    background-color: var(--text-mahogany);
    color: var(--bg-cream);
    border: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
  }

  /* Mobile Optimization */
  @media (max-width: 900px) {
    .site-nav-header {
      padding: 1rem 1.5rem;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .nav-links {
      gap: 1.2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .hero-section {
      padding-top: 7rem;
      padding-bottom: 1.5rem;
    }

    .hero-section h1 {
      font-size: 2.2rem; 
      letter-spacing: 0.15em;
    }

    .subtitle {
      font-size: 0.85rem;
      letter-spacing: 0.2em;
    }

    .text-section, .footer-section {
      padding: 5rem 1.5rem;
    }

    .text-container.centered h2 {
      font-size: 2.2rem;
    }

    .body-text {
      font-size: 1.15rem;
    }

    .image-break {
      padding: 0 1.5rem;
    }

    .caption-centered {
      width: calc(100% - 3rem);
      flex-direction: column;
      gap: 0.5rem;
      align-items: flex-start;
    }

    .vertical-layout {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .vertical-layout.reverse .content-side {
      order: 0;
    }

    .double-spread {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding-top: 3rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .contact-email {
      font-size: 1.5rem;
    }
  }
</style>