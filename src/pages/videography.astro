---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Cinematic Property & Brand Videography Bristol | The Lightworks"
  description="Premium architectural walkthroughs, highlight films, and promotional brand videography in Bristol. Shot on industry-leading Sony cinematic cameras."
>
  <div class="page-wrapper">
    

    <!-- VIDEO SUBPAGE HERO -->
    <section class="subpage-hero video-hero" id="home">
      <div class="fullwidth-video-wrapper">
        <!-- Desktop Video -->
        <video class="desktop-hero-video" autoplay muted loop playsinline preload="auto">
          <source src="/videos/Web_wide.mp4" type="video/mp4" />
        </video>
        <!-- Mobile Video -->
        <video class="mobile-hero-video" autoplay muted loop playsinline preload="auto">
          <source src="/videos/Web_vertical.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay-text">
          <h1>Cinematic Videography</h1>
          <p class="subtitle italic" style="color: #F9F6F0;">Motion that elevates spaces and defines brands.</p>
        </div>
      </div>
    </section>

    <!-- INTRO PHILOSOPHY & EQUIPMENT -->
    <section class="image-break vertical-layout" style="padding-top: 5rem;">
      <div class="content-side" style="padding-right: 2rem;">
        <h2>CAPTURING THE ATMOSPHERE</h2>
        <p class="body-text">
          Video is the most powerful way to capture the true flow of a property. We produce high-end, cinematic content that doesn't just show a room—it lets your audience feel what it’s like to be there.
        </p>
        <p class="body-text">
          To achieve uncompromising, editorial-grade results, we shoot exclusively on <strong>top-of-the-range Sony cinematic cameras</strong>. Paired with the latest generation of electronic stabilization equipment and professional location lighting, we deliver smooth, brilliantly exposed footage that meets the highest commercial standards.
        </p>
      </div>
      <div class="image-wrapper">
        <img src="/images/Grid/Grid_900p_006.JPG" alt="Cinematic Architectural Videography Bristol" style="object-fit: cover; width: 100%; max-height: 75vh;" />
      </div>
      <div class="full-width-divider"></div>
    </section>

    <!-- COMPREHENSIVE SERVICES -->
    <section class="str-services-section">
      <div class="text-container centered" style="margin-bottom: 4rem;">
        <h2>Motion Portfolios</h2>
        <p class="body-text" style="text-wrap: balance; max-width: 700px; margin: 1.5rem auto 0 auto;">
          From fluid interior tours to high-impact commercial campaigns, our videography services are tailored to maximize engagement across every digital platform.
        </p>
      </div>

      <div class="str-services-grid">
        <div class="str-service-column">
          <h3>Property & Architecture</h3>
          <ul class="editorial-list">
            <li><strong>Architectural Walkthroughs:</strong> Seamless, stabilized tours that accurately map the spatial flow and proportions of a property.</li>
            <li><strong>Highlight Videos:</strong> Emotional, music-driven montages focusing on premium finishes, natural light, and lifestyle elements.</li>
            <li><strong>Aerial Video Integration:</strong> Aerial drone footage seamlessly combined with your main video to show the property's true surroundings.</li>
          </ul>
        </div>

        <div class="str-service-column">
          <h3>Brand & Commercial</h3>
          <ul class="editorial-list">
            <li><strong>Promotional Brand Films:</strong> High-end narrative videos designed for website headers, launches, and digital ad campaigns.</li>
            <li><strong>Staged & Lifestyle Video:</strong> Directed, dynamic footage featuring models or staff to bring commercial spaces and services to life.</li>
            <li><strong>Interviews & Testimonials:</strong> Clear, professionally lit interviews that build instant trust with your audience.</li>
          </ul>
        </div>

        <div class="str-service-column">
          <h3>Social Media Optimization</h3>
          <ul class="editorial-list">
            <li><strong>Vertical Formatting:</strong> Content shot and framed specifically for 9:16 aspect ratios (Instagram Reels, TikTok, YouTube Shorts).</li>
            <li><strong>Fast-Paced Edits:</strong> Trend-conscious, highly engaging short-form video engineered for algorithmic reach and direct bookings.</li>
            <li><strong>Behind-the-Scenes:</strong> Authentic, stylized process videos that humanize your brand and connect with followers.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PRICING & CTA BANNER -->
    <section class="pricing-banner">
      <div class="text-container centered">
        <h2 style="color: #F9F6F0;">Tailored Production</h2>
        <p class="body-text" style="color: rgba(249, 246, 240, 0.85); text-wrap: balance; max-width: 600px; margin: 1.5rem auto 2.5rem auto;">
          Whether you are adding video to a photography package or booking a standalone shoot, we tailor our video production to fit exactly what you need.
        </p>
        <p class="pricing-highlight">Add-ons starting from&nbsp;£149.</p>
      </div>
    </section>

    <!-- CONTACT FOOTER -->
    <footer class="footer-section" id="contact">
      <div class="text-container centered">
        <h2>Get in Touch</h2>
        <p class="subtitle italic">Request a personalized quote and discuss your project vision.</p>
        
        <div class="contact-details">
          <a href="mailto:enquiries@thelightworks.art" class="contact-email">enquiries@thelightworks.art</a>
        </div>

        <form class="luxury-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="d8c351b8-59e4-4c99-9236-ecd105a16121">
          <div class="form-group">
            <input type="text" name="name" placeholder="Your Name" required />
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Your Email Address" required />
          </div>
          <div class="form-group">
            <textarea name="message" placeholder="Tell us about the space, project timeline, and your video requirements." rows="4" required></textarea>
          </div>
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
          <button type="submit" class="submit-btn">Send Enquiry</button>
        </form>
        
        <p class="copyright">&copy; 2026 The Lightworks. All Rights Reserved.</p>
      </div>
    </footer>

  </div>
</Layout>

<style>
  :root {
    --bg-cream: #F9F6F0;
    --text-mahogany: #241A16;
    --muted-mahogany: #63524A;
    --border-mahogany: rgba(36, 26, 22, 0.15);
  }

  html {
    scroll-behavior: smooth;
    background-color: var(--bg-cream) !important;
    overflow-x: hidden;
  }

  section, footer {
    scroll-margin-top: 80px; 
  }

  body {
    background-color: var(--bg-cream) !important;
    color: var(--text-mahogany) !important;
    font-family: 'Cormorant Garamond', serif !important;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    width: 100%;
    position: relative;
    -webkit-font-smoothing: antialiased;
  }

  .page-wrapper {
    width: 100%;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  /* Fixed Navigation Header */
  .site-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem 4rem;
    background-color: var(--bg-cream);
    border-bottom: 1px solid var(--border-mahogany);
    box-sizing: border-box;
  }

  .nav-brand {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-size: 1.5rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1;
  }

  .brand-subtitle {
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin-top: 0.35rem;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2.5rem;
  }

  .nav-links a {
    color: var(--text-mahogany);
    text-decoration: none;
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* Typography */
  h1, h2, h3 {
    font-weight: 300;
    color: var(--text-mahogany);
    margin: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
    margin: 0.75rem 0 0 0;
  }

  .subtitle.italic {
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
  }

  .body-text {
    font-size: 1.4rem;
    line-height: 1.8;
    color: var(--muted-mahogany);
    font-weight: 400;
    margin: 2rem 0;
  }

  .text-container.centered {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .text-container.centered h2 {
    font-size: 3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Video Subpage Hero */
  .subpage-hero {
    width: 100%;
    margin-top: 95px;
    padding: 0;
    box-sizing: border-box;
  }

  .fullwidth-video-wrapper {
    width: 100%;
    position: relative;
    height: 70vh; 
    overflow: hidden;
    background-color: var(--text-mahogany);
  }

  .fullwidth-video-wrapper video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.6; /* Darkens video significantly so text pops */
  }

  .desktop-hero-video {
    display: block;
  }

  .mobile-hero-video {
    display: none;
  }

  .hero-overlay-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 90%;
    max-width: 1000px;
    z-index: 2;
  }

  .hero-overlay-text h1 {
    color: #F9F6F0;
    font-size: 4rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
    text-wrap: balance;
  }

  /* Split Layout */
  .image-break {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    box-sizing: border-box;
  }

  .vertical-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 5rem;
    padding-bottom: 4rem;
    box-sizing: border-box;
  }

  .vertical-layout .image-wrapper {
    flex: 0 0 40%;
    max-width: 40%;
  }

  .vertical-layout .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .vertical-layout .content-side {
    flex: 1;
    min-width: 0;
  }

  .content-side h2 {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
  }

  .full-width-divider {
    flex: 0 0 100%;
    border-bottom: 1px solid var(--border-mahogany);
    width: 100%;
    margin-top: 2rem;
  }

  /* STR Services Grid */
  .str-services-section {
    padding: 4rem 4rem 6rem 4rem;
    max-width: 1600px;
    margin: 0 auto;
  }

  .str-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  .str-service-column h3 {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-mahogany);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .editorial-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }

  .editorial-list li {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted-mahogany);
    margin-bottom: 1.5rem;
  }

  .editorial-list li strong {
    color: var(--text-mahogany);
    font-weight: 400;
    display: block;
    font-size: 1.25rem;
    margin-bottom: 0.2rem;
  }

  /* Pricing Banner */
  .pricing-banner {
    background-color: var(--text-mahogany);
    padding: 6rem 2rem;
    text-align: center;
  }

  .pricing-highlight {
    font-size: 2.5rem;
    letter-spacing: 0.1em;
    color: #F9F6F0;
    text-transform: uppercase;
    font-weight: 300;
    border: 1px solid rgba(249, 246, 240, 0.3);
    display: inline-block;
    padding: 1.5rem 3rem;
  }

  /* Footer / Contact */
  .footer-section {
    padding: 4rem 2rem 6rem 2rem;
    background-color: #F2EFE9;
  }

  .contact-details {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .contact-email {
    font-size: 2rem;
    color: var(--text-mahogany);
    text-decoration: none;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s;
  }

  .contact-email:hover {
    opacity: 0.6;
  }

  .luxury-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin: 0 auto 5rem auto;
    max-width: 600px;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1.25rem;
    background: transparent;
    border: 1px solid var(--border-mahogany);
    color: var(--text-mahogany);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--text-mahogany);
  }

  .submit-btn {
    width: 100%;
    padding: 1.25rem;
    background-color: var(--text-mahogany);
    color: var(--bg-cream);
    border: none;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.3s;
  }

  .submit-btn:hover {
    opacity: 0.8;
  }

  .copyright {
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted-mahogany);
  }

  /* ==========================================
     MOBILE OPTIMIZATION
     ========================================== */
@media (max-width: 768px) {
    body, html, .page-wrapper {
      overflow-x: hidden !important;
      width: 100% !important;
    }

    section, footer {
      scroll-margin-top: 115px; 
    }

    .site-nav-header {
      padding: 1rem 0.5rem !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 1rem !important;
    }

    .nav-brand {
      align-items: center !important;
      text-align: center !important;
    }

    .nav-brand .brand-title {
      font-size: 1.15rem !important;
    }

    .nav-brand .brand-subtitle {
      font-size: 0.55rem !important;
      margin-top: 0.3rem !important;
    }

    .nav-links {
      gap: 1.5rem !important;
    }

    .nav-links a {
      font-size: 0.65rem !important;
    }

    .subpage-hero {
      margin-top: 130px !important;
    }

    .fullwidth-video-wrapper {
      height: 50vh !important;
    }

    .desktop-hero-video {
      display: none !important;
    }

    .mobile-hero-video {
      display: block !important;
    }

    .hero-overlay-text h1 {
      font-size: 2.2rem !important;
    }

    .hero-overlay-text .subtitle {
      font-size: 0.85rem !important;
      margin-top: 1rem !important;
    }

    .image-break {
      padding: 0 1rem !important;
    }

    .vertical-layout {
      display: flex !important;
      flex-direction: column !important;
      gap: 2rem !important;
      padding-top: 2.5rem !important;
    }

    .vertical-layout .content-side {
      padding-right: 0 !important;
    }

    .vertical-layout .content-side h2 {
      font-size: 1.5rem !important;
      text-align: center !important;
      margin-bottom: 1.5rem !important;
    }

    .vertical-layout .body-text {
      font-size: 0.9rem !important;
      line-height: 1.5 !important;
      margin-bottom: 1rem !important;
    }

    .vertical-layout .image-wrapper {
      width: 100% !important;
      max-width: 100% !important;
    }

    .full-width-divider {
      width: 100vw !important;
      position: relative !important;
      left: 50% !important;
      right: 50% !important;
      margin-left: -50vw !important;
      margin-right: -50vw !important;
    }

    .str-services-section {
      padding: 2rem 1rem 4rem 1rem !important;
    }

    .str-services-section .text-container.centered h2 {
      font-size: 1.5rem !important;
    }

    .str-services-section .body-text {
      font-size: 0.9rem !important;
      line-height: 1.5 !important;
    }

    .str-services-grid {
      grid-template-columns: 1fr !important;
      gap: 3rem !important;
    }

    .str-service-column h3 {
      font-size: 1.25rem !important;
    }

    .editorial-list li {
      font-size: 0.9rem !important;
    }

    .editorial-list li strong {
      font-size: 1.05rem !important;
    }

    .pricing-banner {
      padding: 4rem 1rem !important;
    }

    .pricing-banner h2 {
      font-size: 1.75rem !important;
    }

    .pricing-banner .body-text {
      font-size: 0.9rem !important;
    }

    .pricing-highlight {
      font-size: 1.5rem !important;
      padding: 1rem 1.5rem !important;
    }

    .footer-section {
      padding: 2.5rem 1rem 3rem 1rem !important; 
    }

    .footer-section .text-container.centered h2 {
      font-size: 1.5rem !important;
    }

    .footer-section .text-container.centered .subtitle {
      font-size: 0.8rem !important;
      margin-bottom: 1.5rem !important;
    }

    .contact-email {
      font-size: 1.25rem !important;
    }

    .luxury-form {
      gap: 1rem !important; 
      margin-bottom: 2rem !important;
    }

    .form-group input,
    .form-group textarea,
    .submit-btn {
      padding: 1rem !important; 
      font-size: 0.9rem !important; 
    }
  }
</style>